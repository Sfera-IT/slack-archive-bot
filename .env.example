# Slack bot event API
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me
# Optional readiness fallback if Slack auth.test is temporarily unavailable.
# SLACK_BOT_USER_ID=U_REPLACE_WITH_THE_REAL_BOT_ID

# SferaArchive OAuth application (required at startup)
SECRET_KEY=replace-with-at-least-32-random-characters
CLIENT_ID=replace-me
CLIENT_SECRET=replace-me
OAUTH_SCOPE=channels:read,groups:read,users:read
EXPECTED_TEAM_ID=T00000000
CLIENT_URL=https://sferaarchive-client.vercel.app/
OAUTH_REDIRECT_URI=https://slack-archive.sferait.org/oauth_callback

# OpenAI
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
# Emergency safe mode: set both to false without downgrading to an unsafe image.
ARCHIVE_AGENT_ENABLED=true
THREAD_ENGAGEMENT_ENABLED=true

# Optional runtime path overrides. Local defaults are ./slack.sqlite and
# ./podcast.mp3; the Docker image supplies /data defaults.
# ARCHIVE_BOT_DATABASE_PATH=./slack.sqlite
# DB_PATH=./slack.sqlite
# PODCAST_AUDIO_PATH=./podcast.mp3
SFERAARCHIVE_FRONTEND_URL=https://sferaarchive-client.vercel.app/
